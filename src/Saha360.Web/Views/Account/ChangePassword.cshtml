@model Saha360.Web.Controllers.ChangePasswordInput
@{
    ViewData["Title"] = "Parola değiştir";
}
<h1 class="page-title">Parola değiştir</h1>
<div class="card" style="max-width:480px">
    <div class="card-body">
        <form method="post" action="/parola">
            <div asp-validation-summary="All" class="text-danger small"></div>
            <div class="mb-3">
                <label class="form-label" for="CurrentPassword">Mevcut parola</label>
                <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="NewPassword">Yeni parola (en az 8 karakter, en az bir rakam)</label>
                <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="ConfirmPassword">Yeni parola (tekrar)</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            </div>
            <button class="btn btn-primary" type="submit">Değiştir</button>
        </form>
    </div>
</div>
