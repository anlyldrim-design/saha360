@model PagedResult<AuditLog>
@{
    ViewData["Title"] = "Sistem ve Denetim";
    var names = (Dictionary<string, string>)ViewData["Names"]!;
    var info = (Dictionary<string, string>)ViewData["Info"]!;
}
<h1 class="page-title">Sistem ve Denetim</h1>
<div class="row g-3">
    <div class="col-lg-4">
        <section class="card">
            <div class="card-header">Sistem bilgisi</div>
            <dl class="kv card-body mb-0">
                @foreach (var kv in info) { <dt>@kv.Key</dt><dd>@kv.Value</dd> }
                <dt>Sağlık kontrolü</dt><dd><a href="/saglik" target="_blank">/saglik</a></dd>
            </dl>
        </section>
        <p class="small text-secondary mt-2">Yedekleme, dağıtım ve ilk yönetici kurulumu için README › “Yayına alma” bölümüne bakın.</p>
    </div>
    <div class="col-lg-8">
        <section class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>Denetim kaydı (değiştirilemez)</span>
                <form method="get" class="d-flex gap-2"><input name="q" value="@Context.Request.Query["q"]" class="form-control form-control-sm" placeholder="Ara" aria-label="Denetim kaydında ara" /><button class="btn btn-sm btn-outline-primary" type="submit">Ara</button></form>
            </div>
            <div class="table-responsive"><table class="table table-sm align-middle mb-0">
                <thead><tr><th>Zaman</th><th>Kim</th><th>İşlem</th><th>Özet</th><th>IP</th></tr></thead>
                <tbody>
                    @foreach (var a in Model.Items)
                    {
                        <tr>
                            <td class="small text-nowrap">@TrTime.Format(a.OccurredAtUtc)</td>
                            <td class="small">@(a.ActorUserId is not null && names.TryGetValue(a.ActorUserId, out var n) ? n : "Sistem")</td>
                            <td class="small"><code>@a.Action</code></td>
                            <td class="small">@if (a.WorkOrderId is int w) { <a href="/isler/@w">#@w</a> } @a.Summary</td>
                            <td class="small text-secondary">@a.IpAddress</td>
                        </tr>
                    }
                </tbody>
            </table></div>
        </section>
        <partial name="_Pager" model="(Model.Page, Model.TotalPages, Model.Total)" />
    </div>
</div>
