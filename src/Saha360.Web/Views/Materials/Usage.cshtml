@model List<MaterialService.UsageRow>
@{
    ViewData["Title"] = "İş Bazlı Malzeme Kullanımı";
}
<div class="page-head">
    <div>
        <h1 class="page-title">İş Bazlı Malzeme Kullanımı</h1>
        <p class="text-secondary mb-0">Yetkinizdeki işlerde bildirilen malzeme tüketimi (son 500 kayıt). Toplamlar için Raporlar › Malzeme kullanımı.</p>
    </div>
</div>
<form method="get" class="d-flex gap-2 mb-2" role="search">
    <input name="q" value="@ViewData["Q"]" class="form-control" placeholder="Malzeme adı ara" aria-label="Malzeme ara" />
    <button class="btn btn-outline-primary" type="submit">Ara</button>
</form>
<div class="card"><div class="card-body p-0"><div class="table-responsive">
    <table class="table align-middle mb-0">
        <thead><tr><th>İş</th><th>Malzeme</th><th class="text-end">Miktar</th><th>Birim</th><th>Kayıt</th></tr></thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr><td><a href="/isler/@r.WorkOrderId#malzemeler">@r.WorkNumber</a> <span class="small">@r.Title</span></td><td>@r.Material</td>
                    <td class="text-end">@r.Quantity.ToString("0.###", TrTime.Culture)</td><td>@r.Unit</td><td class="small">@TrTime.Format(r.AddedAtUtc)</td></tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="5" class="text-secondary p-3">Kayıt yok.</td></tr> }
        </tbody>
    </table>
</div></div></div>
